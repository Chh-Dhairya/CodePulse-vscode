{
  "name": "codepulse-vscode",
  "displayName": "CodePulse",
  "description": "Local-first, agent-native code intelligence for VS Code — search, symbol navigation, references, and impact analysis, powered by a local CodePulse server.",
  "version": "0.1.0",
  "publisher": "codepulse",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "code intelligence",
    "search",
    "mcp",
    "model context protocol",
    "code navigation",
    "call graph",
    "local-first"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codepulse.setApiKey",
        "title": "CodePulse: Set API Key"
      },
      {
        "command": "codepulse.checkConnection",
        "title": "CodePulse: Check Server Connection"
      },
      {
        "command": "codepulse.startServer",
        "title": "CodePulse: Start Local Server"
      },
      {
        "command": "codepulse.indexWorkspace",
        "title": "CodePulse: Index Workspace"
      },
      {
        "command": "codepulse.search",
        "title": "CodePulse: Search"
      },
      {
        "command": "codepulse.moduleStructure",
        "title": "CodePulse: Module Structure"
      },
      {
        "command": "codepulse.showImpact",
        "title": "CodePulse: Show Impact Analysis"
      },
      {
        "command": "codepulse.openReferenceFile",
        "title": "CodePulse: Open Reference File"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "codepulse.showImpact",
          "when": "false"
        },
        {
          "command": "codepulse.openReferenceFile",
          "when": "false"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codepulse",
          "title": "CodePulse",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codepulse": [
        {
          "id": "codepulse.references",
          "name": "References"
        },
        {
          "id": "codepulse.similarCode",
          "name": "Similar Code"
        }
      ]
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "codepulse.mcpServers",
        "label": "CodePulse"
      }
    ],
    "configuration": {
      "title": "CodePulse",
      "properties": {
        "codepulse.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "Base URL of the CodePulse REST API server."
        },
        "codepulse.autoLaunchServer": {
          "type": "boolean",
          "default": true,
          "description": "If no CodePulse server is reachable when a workspace opens, offer to launch one locally (`codepulse serve`)."
        },
        "codepulse.serverCommand": {
          "type": "string",
          "default": "codepulse",
          "description": "Command used to launch the local CodePulse server. Must be on PATH, or an absolute path to the codepulse executable."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.4.0"
  }
}

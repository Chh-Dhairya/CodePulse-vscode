{
  "name": "codepulse-code-intelligence",
  "displayName": "CodePulse Code Intelligence",
  "description": "Local-first, agent-native code intelligence for VS Code — search, symbol navigation, references, and impact analysis, powered by a local CodePulse server.",
  "version": "0.2.0",
  "publisher": "codepulse-repository-indexer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Chh-Dhairya/codepulse-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/Chh-Dhairya/codepulse-vscode/issues"
  },
  "homepage": "https://github.com/Chh-Dhairya/codepulse-vscode#readme",
  "preview": true,
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "code intelligence",
    "search",
    "mcp",
    "model context protocol",
    "code navigation",
    "call graph",
    "local-first"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In an untrusted workspace CodePulse still searches and navigates a server that is already running, but it never starts a server process and does not register its MCP server."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "CodePulse indexes folders on disk and starts a local server, so it needs a real folder, not a virtual file system."
    }
  },
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codepulse.setApiKey",
        "title": "CodePulse: Set API Key"
      },
      {
        "command": "codepulse.checkConnection",
        "title": "CodePulse: Check Server Connection"
      },
      {
        "command": "codepulse.startServer",
        "title": "CodePulse: Start Local Server"
      },
      {
        "command": "codepulse.indexWorkspace",
        "title": "CodePulse: Index Workspace"
      },
      {
        "command": "codepulse.search",
        "title": "CodePulse: Search"
      },
      {
        "command": "codepulse.moduleStructure",
        "title": "CodePulse: Module Structure"
      },
      {
        "command": "codepulse.showImpact",
        "title": "CodePulse: Show Impact Analysis"
      },
      {
        "command": "codepulse.openReferenceFile",
        "title": "CodePulse: Open Reference File"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "codepulse.showImpact",
          "when": "false"
        },
        {
          "command": "codepulse.openReferenceFile",
          "when": "false"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codepulse",
          "title": "CodePulse",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codepulse": [
        {
          "id": "codepulse.references",
          "name": "References"
        },
        {
          "id": "codepulse.similarCode",
          "name": "Similar Code"
        }
      ]
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "codepulse.mcpServers",
        "label": "CodePulse"
      }
    ],
    "configuration": {
      "title": "CodePulse",
      "properties": {
        "codepulse.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "scope": "machine",
          "description": "Base URL of the CodePulse REST API server. Your API key is sent to this address. Machine-scoped: set it in your user settings; a project's own .vscode/settings.json cannot change it."
        },
        "codepulse.autoLaunchServer": {
          "type": "boolean",
          "default": true,
          "description": "If no CodePulse server is reachable when a workspace opens, offer to launch one locally (`codepulse serve`). The offer shows the exact command line, and \"Don't Ask Again\" turns this off."
        },
        "codepulse.serverCommand": {
          "type": "string",
          "default": "codepulse",
          "scope": "machine",
          "description": "The codepulse executable used to launch the local server: on PATH, or an absolute path. It is run directly as a single program (not through a shell). Machine-scoped: set it in your user settings; a project's own .vscode/settings.json cannot change it."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "test": "npm run compile && node --test \"test/unit/*.test.mjs\"",
    "test:e2e": "node test/e2e/run-all.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.4.0"
  }
}
